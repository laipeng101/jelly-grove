{
  "name": "jelly-grove",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && npm run build:bundle",
    "build:bundle": "vite build && node scripts/package-offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test \"tests/logic/**/*.test.ts\"",
    "test:generation": "node --import tsx --test \"tests/generation/*.test.ts\"",
    "test:types": "tsc -p tsconfig.test.json",
    "browser:install": "node --import ./scripts/playwright.mjs node_modules/@playwright/test/cli.js install chromium",
    "test:browser": "node --import ./scripts/playwright.mjs node_modules/@playwright/test/cli.js test",
    "verify": "npm run test:types && npm test && npm run test:generation && npm run test:browser",
    "journey:benchmark": "tsx scripts/benchmark-journey.ts",
    "journey:benchmark:browser": "npm run build:bundle && node --import ./scripts/playwright.mjs scripts/benchmark-journey-browser.mjs",
    "journey:backups": "tsx scripts/build-journey-backups.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
